rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function logado() { return request.auth != null; }

    function perfil() {
      return get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data;
    }
    function temPerfil() {
      return logado() &&
        exists(/databases/$(database)/documents/usuarios/$(request.auth.uid));
    }
    function ehCoordenador() {
      return temPerfil() && perfil().papel == "coordenador" && perfil().aprovado == true;
    }
    function ehProfessor() {
      return temPerfil() && perfil().papel == "professor" && perfil().aprovado == true;
    }
    function ehEquipe() { return ehCoordenador() || ehProfessor(); }

    match /usuarios/{uid} {
      allow read: if logado() && (request.auth.uid == uid || ehCoordenador());
      allow create: if logado() && request.auth.uid == uid
                    && request.resource.data.uid == uid;
      allow update, delete: if ehCoordenador();
    }

    match /configuracoes/{doc} {
      allow read, write: if true;
    }

    match /alunos/{codigo} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if ehEquipe();
    }

    match /turmas/{codigo} {
      allow read: if true;
      allow write: if ehCoordenador();
    }

    match /matriculas/{id} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if ehEquipe();
    }

    match /chamadas/{id} {
      allow read: if true;
      // Professor pode abrir/encerrar chamadas
      allow create, update, delete: if ehEquipe();
    }

    match /presencas/{id} {
      allow read: if true;
      // Professor e coordenador marcam presença
      // Regra mais permissiva: qualquer usuário logado pode gravar presença
      // (o controle real é feito pela interface — só o professor vê os botões)
      allow create, update, delete: if logado();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
